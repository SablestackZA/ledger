# App connection. Must be the restricted ledger_app role (no UPDATE/DELETE on entries, no DDL).
# Production: the ledger_app POOLED Neon URL. The Neon integration's own DATABASE_URL is the
# owner role; the app ignores it whenever this is set, and on Vercel it refuses to write unless
# it is connected as ledger_app.
LEDGER_DATABASE_URL=postgres://ledger_app@127.0.0.1:54329/ledger

# Owner connection for `pnpm db:migrate`. Falls back to DATABASE_URL_UNPOOLED, then DATABASE_URL.
# Must be unpooled: the migration lock is session-level. Never set on the running app.
MIGRATE_DATABASE_URL=postgres://ledger@127.0.0.1:54329/ledger

# Hex SHA-256 of the write API key. Generate:
#   export LEDGER_API_KEY=$(openssl rand -hex 24)
#   printf %s "$LEDGER_API_KEY" | shasum -a 256 | cut -d' ' -f1
LEDGER_API_KEY_SHA256=

# The plain write key. Used only by clients and loadtest/run.sh; the server never reads it.
LEDGER_API_KEY=

# Guards /api/cron/reset. Vercel Cron sends it as a bearer token.
CRON_SECRET=

# Optional. Pool size per server process (default 20).
# DB_POOL_MAX=20

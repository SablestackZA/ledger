{
  "name": "sablestack-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sablestack Ledger: a double-entry ledger API. Built in-house by Sablestack (Pty) Ltd.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "pnpm db:up && vitest run",
    "test:unit": "vitest run tests/unit",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "^16",
    "postgres": "^4.1.0",
    "react": "^19",
    "react-dom": "^19",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
